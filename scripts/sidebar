#!/usr/bin/env bash
# Sidebar of machines, their spaces and the agents running in them, from the @agent_* options tmux-agents sets
set -uo pipefail

source "$(dirname "$0")/lib.sh"
c_fg=$'\e[39m'
# Badge colours when the theme sets no @thm_badges
badge_bgs=(61 72 71 173 132 167 67 137)
# Marks where a row returns to its own background, so the selected row keeps its highlight
bg=$'\x01'

fit() {
  local s=$1 w=$2
  if (( w <= 0 )); then
    return
  fi

  if (( ${#s} > w )); then
    s="${s:0:w-1}…"
  fi
  printf '%s' "$s"
}

spaces() {
  if (( $1 > 0 )); then
    printf '%*s' "$1" ''
  fi
}

age() {
  local d=$(( now - $1 ))
  if [[ -z $1 ]]; then
    return
  elif (( d < 60 )); then
    echo '<1m'
  elif (( d < 3600 )); then
    echo "$(( d / 60 ))m"
  elif (( d < 86400 )); then
    echo "$(( d / 3600 ))h"
  else
    echo "$(( d / 86400 ))d"
  fi
}

add_row() {
  rows+=("$1")
  targets+=("${2:-}")
}

# A green dot while a connection is open, a grey ring for a pinned machine with none, and the stats the
# watcher last read from it: cpu and memory in use as a share, and load
machine_row() {
  local name target=$2 dot=${c_on}● stats='' cpu mem load key
  if [[ ${3:-1} != 1 ]]; then
    dot=${c_meta}○
  fi

  if [[ -n $target ]]; then
    key=$(printf '%s' "${target#host:}" | tr -c 'A-Za-z0-9_' '_')
    IFS='|' read -r cpu mem load <<<"$(state_read "stats_$key")"
    if [[ -n ${cpu:-} ]]; then
      stats="$cpu% $mem% $load "
    fi
  fi

  name=$(fit "$1" $(( width - 5 - ${#stats} )))
  add_row " ${c_head}▭ $name$(spaces $(( width - 5 - ${#stats} - ${#name} )))${c_meta}$stats$dot${c_fg} " "$target"
}

# The server's tmux sessions this Mac has no window on, such as one whose window was closed, to reattach
detached_rows() {
  local host=$1 open=$2 key name att path title label meta
  key=$(printf '%s' "$host" | tr -c 'A-Za-z0-9_' '_')
  while IFS=$sep read -r name att path title; do
    if [[ -z $name || $open == *" $name "* ]]; then
      continue
    fi

    label=$(clean_title "$title")
    if ! agent_title "$(plain "$title")"; then
      label=${path##*/}
      if [[ $path =~ ^(/home/[^/]+|/Users/[^/]+|/root)/?$ ]]; then
        label='~'
      fi
    fi

    meta=detached
    if [[ $att =~ ^[1-9] ]]; then
      meta=elsewhere
    fi

    label=$(fit "${label:-$name}" $(( width - 7 - ${#meta} - 1 )))
    add_row "   ${c_meta}↺  ${c_name}$label$(spaces $(( width - 7 - ${#meta} - 1 - ${#label} ))) ${c_meta}$meta${c_fg} " "attach:$host:$name"
  done <<<"$(state_read "remote_$key")"
}

new_row() {
  add_row "   ${c_meta}+  new${c_fg}" "host:$1"
}

space_row() {
  local name=$1 meta=$2 target=$3 badge h nw
  h=$(cksum <<<"$name" | cut -d' ' -f1)
  if (( ${#badge_list[@]} > 0 )); then
    badge=$(colour 48 "${badge_list[h % ${#badge_list[@]}]}" 61)$c_badge_fg
  else
    badge=$'\e[48;5;'"${badge_bgs[h % ${#badge_bgs[@]}]}"$'m\e[38;5;255m'
  fi
  meta=$(fit "$meta" $(( width / 2 - 2 )))
  nw=$(( width - 7 - ${#meta} - 1 ))
  name=$(fit "$name" "$nw")
  add_row "  $badge"$'\e[1m'" $(tr '[:lower:]' '[:upper:]' <<<"${name:0:1}") "$'\e[22m'"$bg${c_name} $name$(spaces $(( nw - ${#name} ))) ${c_meta}$meta${c_fg} " "$target"
}

# Sets icon and color for an agent state
state_mark() {
  case $1 in
    (blocked) icon='!' color=$c_blocked ;;
    (asking) icon='?' color=$c_asking ;;
    (waiting) icon='●' color=$c_on ;;
    (working) icon='⠿' color=$c_working ;;
    (*) icon='○' color=$c_idle ;;
  esac
}

# A row nested under a space, indented, with a prefix such as a window index or a tree branch
tree_row() {
  local indent=$1 prefix=$2 plen=$3 name=$4 meta=$5 target=$6 nw
  meta=$(fit "$meta" $(( width / 2 - 2 )))
  nw=$(( width - indent - plen - ${#meta} - 2 ))
  name=$(fit "$name" "$nw")
  add_row "$(spaces "$indent")$prefix${c_name}$name$(spaces $(( nw - ${#name} ))) ${c_meta}$meta${c_fg} " "$target"
}

agent_row() {
  local state=$1 since=$2 name=$3 detail=$4 target=$5 subs=${6:-} icon color when lw text
  state_mark "$state"
  when=$(age "$since")
  # The subagents this Claude runs, from the watcher's count
  if [[ $subs =~ ^[1-9][0-9]*$ ]]; then
    when="⑂$subs $when"
  fi
  lw=$(( width - 6 - ${#when} ))
  name=$(fit "$name" "$lw")
  text=$name
  if (( lw - ${#name} > 5 )) && [[ -n $detail ]]; then
    detail=$(fit "$detail" $(( lw - ${#name} - 3 )))
    text="$name · $detail"
  fi
  add_row "  $color$icon ${c_name}$name${c_meta}${text:${#name}}$(spaces $(( lw - ${#text} ))) $when${c_fg} " "$target"
}

# With @agents-sidebar-panes on, this computer lists each session, its windows, and the panes of a split
# window. A window with one pane shows that pane's folder on its own row
local_tree() {
  local tabs=$1 my_sess=$2 i j k m n c s w first one last act br glyph icon color pre plen pin
  local f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13
  local -a L_sess L_win L_idx L_wname L_id L_path L_active L_pact L_state L_view L_label L_meta
  n=0
  while IFS=$sep read -r f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13; do
    if [[ -z $f5 ]]; then
      continue
    fi

    L_sess[n]=$f1 L_win[n]=$f2 L_idx[n]=$f3 L_wname[n]=$f4 L_id[n]=$f5 L_path[n]=$f7 L_active[n]=$f8
    L_pact[n]=$f9 L_state[n]=$f10 L_view[n]=$f11 L_label[n]=$f12 L_meta[n]=$f13
    n=$(( n + 1 ))
  done <<<"$3"

  i=0
  while (( i < n )); do
    s=${L_sess[i]}
    j=$i
    while (( j < n )) && [[ ${L_sess[j]} == "$s" ]]; do
      j=$(( j + 1 ))
    done

    # With sessions as tabs, only the windows of the sidebar's own session show
    if [[ $tabs == sessions && $s != "$my_sess" ]]; then
      i=$j
      continue
    fi

    if [[ $tabs != sessions ]]; then
      br=
      for (( k = i; k < j; k++ )); do
        if [[ ${L_active[k]} == 1 ]]; then
          br=$(git -C "${L_path[k]}" symbolic-ref --short HEAD 2>/dev/null)
        fi
      done
      space_row "$s" "$br" "session:$s"
    fi

    k=$i
    while (( k < j )); do
      w=${L_win[k]}
      first=$k
      while (( k < j )) && [[ ${L_win[k]} == "$w" ]]; do
        k=$(( k + 1 ))
      done

      c=0 one=$first act=$first
      for (( m = first; m < k; m++ )); do
        if [[ ${L_pact[m]} == 1 ]]; then
          act=$m
        fi

        if [[ ${L_view[m]} != 1 ]]; then
          c=$(( c + 1 ))
          one=$m
        fi
      done
      last=$one

      if [[ $tabs == sessions ]]; then
        space_row "${L_wname[first]}" "${L_idx[first]}" "pane:${L_id[act]}"
      elif (( c == 1 )); then
        tree_row 4 "${c_meta}${L_idx[first]} " $(( ${#L_idx[first]} + 1 )) "${L_wname[first]}" "${L_meta[one]}" "pane:${L_id[one]}"
      else
        tree_row 4 "${c_meta}${L_idx[first]} " $(( ${#L_idx[first]} + 1 )) "${L_wname[first]}" "" "window:$w"
      fi

      if (( c > 1 )); then
        for (( m = first; m < k; m++ )); do
          if [[ ${L_view[m]} == 1 ]]; then
            continue
          fi

          glyph='├'
          if (( m == last )); then
            glyph='└'
          fi

          pre="${c_meta}$glyph "
          plen=2
          if [[ -n ${L_state[m]} ]]; then
            state_mark "${L_state[m]}"
            pre+="$color$icon "
            plen=4
          fi
          # Panes sit under the badge letter with sessions as tabs, one step under the window row otherwise
          pin=6
          if [[ $tabs == sessions ]]; then
            pin=4
          fi
          tree_row "$pin" "$pre" "$plen" "${L_label[m]}" "${L_meta[m]}" "pane:${L_id[m]}"
        done
      fi
    done
    i=$j
  done
}

build() {
  local panes ps_out id pid cmd sess win path active state since wname title host name m n
  local show_panes locals= view plabel pmeta sess_rows=
  local remote= agents= hosts s idx local_host headless p rsess shost suser tree services t open rs all_remote pact tabs my_sess subs
  rows=() targets=()
  load_palette
  now=$(date +%s)
  local_host=$(tmux display -p "#{host}")
  width=$(tmux display -p -t "$TMUX_PANE" '#{pane_width}')
  panes=$(tmux list-panes -a -F "#{pane_id}$sep#{pane_pid}$sep#{pane_current_command}$sep#{session_name}$sep#{window_id}$sep#{pane_current_path}$sep#{&&:#{window_active},#{pane_active}}$sep#{pane_active}$sep#{@agent_state}$sep#{@agent_since}$sep#{window_name}$sep#{window_index}$sep#{@remote_session}$sep#{@ssh_host}$sep#{@ssh_user}$sep#{@agents_tree}$sep#{@agent_subagents}$sep#{session_id}$sep#{window_index}$sep#{pane_index}$sep#{pane_index}$sep#{pane_title}")
  if grep -Eq "$sep(ssh|mosh-client)$sep" <<<"$panes"; then
    ps_out=$(ps -A -o pid=,ppid=,args=)
  fi

  add_row " ${c_head}Spaces${c_fg}"
  add_row ""
  machine_row "This computer" ""
  tabs=$(tmux show -gqv @agents-tabs)
  my_sess=$(tmux display -p -t "$TMUX_PANE" '#{session_name}')
  headless=$(v=$(tmux show -gqv @agents-headless-sessions); echo "$v")
  show_panes=$(option @agents-sidebar-panes off)
  while IFS=$sep read -r id pid cmd sess win path active pact state since wname idx rsess shost suser tree subs sact wact pout pidx title; do
    title=$(plain "$title")
    wname=$(plain "$wname")
    if [[ -n $headless ]] && headless_session "$sess" "$headless"; then
      if [[ -n $state ]]; then
        p=${path%/*}
        agents+="$state$sep$since$sep${p##*/}$sep$(task_name "$path")$sep$id"$'\n'
      fi
      continue
    fi

    if [[ $show_panes == on ]]; then
      view=0
      if [[ $id == "$TMUX_PANE" || -n $tree ]]; then
        view=1
      fi

      plabel=$cmd
      pmeta=${path##*/}
      if agent_title "$title"; then
        plabel=$(clean_title "$title")
      # A pane connect opened runs ssh under bash, so its session marks it as on a server too
      elif [[ $cmd =~ $ssh_cmds || -n $rsess ]]; then
        plabel=${shost:-ssh}
        pmeta=ssh
      fi
      # Sort keys first: session, window and pane by index, the order the tabs and the number keys use
      locals+="${sact#\$}$sep$sess$sep${wact:-0}$sep$win$sep${pout:-0}$sep$pidx$sep$sess$sep$win$sep$idx$sep$wname$sep$id$sep$cmd$sep$path$sep$active$sep$pact$sep$state$sep$view$sep$plabel$sep$pmeta"$'\n'
    # With sessions as tabs, this computer lists the windows of the session the sidebar is in
    elif [[ $tabs == sessions ]]; then
      if [[ $pact == 1 && $sess == "$my_sess" ]]; then
        space_row "$wname" "$idx" "pane:$id"
      fi
    elif [[ $active == 1 ]]; then
      # tmux lists sessions by name, the tabs and number keys count them by index, so these are sorted below
      sess_rows+="${sact#\$}$sep$sess$sep$(git -C "$path" symbolic-ref --short HEAD 2>/dev/null)"$'\n'
    fi

    # Itself and a tree pane are views, not spaces
    if [[ $id == "$TMUX_PANE" || -n $tree ]]; then
      continue
    fi

    host=
    if [[ $cmd =~ $ssh_cmds || -n $rsess ]]; then
      host=$shost
      if [[ -z $host && $cmd =~ $ssh_cmds ]]; then
        host=$(ssh_host_of "$pid" "$ps_out")
      fi
      host=${host:-$wname}
      m=$(clean_title "$title")
      # A pane starts titled with this machine's name, and a bare user@host has no folder, so neither names a space
      if [[ $title == "$local_host" || ( $title =~ ^[^[:space:]:]+@[^[:space:]:]+([[:space:]]|$) && $title != *:* ) ]]; then
        m=shell
      fi

      if [[ $title =~ :[[:space:]]*(~?/?[^[:space:]]*)$ ]]; then
        m=${BASH_REMATCH[1]##*/}
        m=${m:-${BASH_REMATCH[1]}}
      fi
      # The folder or the agent's task reads best, the session connect named is the fallback
      if [[ $m == shell || -z $m ]]; then
        m=${suser:+$host@$suser}
        m=${m:-${rsess:-shell}}
      fi
      remote+="$host$sep$win$sep$id$sep${m:-shell}$sep$sess:$idx$sep$rsess"$'\n'
    fi

    if [[ -n $state ]]; then
      name=${path##*/}
      name=${host:-$name}
      agents+="$state$sep$since$sep$name$sep$(clean_title "$title")$sep$id$sep$subs"$'\n'
    fi
  done <<<"$panes"

  while IFS=$sep read -r _ s p; do
    if [[ -n $s ]]; then
      space_row "$s" "$p" "session:$s"
    fi
  done < <(printf '%s' "$sess_rows" | sort -t "$sep" -k1,1n)

  if [[ $show_panes == on ]]; then
    local_tree "$tabs" "$my_sess" "$(printf '%s' "$locals" | sort -t "$sep" -k1,1n -k2,2 -k3,3n -k4,4 -k5,5n -k6,6n | cut -d "$sep" -f7-)"
  fi

  # Every pane's session counts as open here, splits included, before the list keeps one space per window
  all_remote=$remote
  # Pinned machines first in their order, then any other host with an open connection
  remote=$(printf '%s' "$remote" | awk -F "$sep" '$1 != "" && !seen[$1 FS $2]++')
  hosts=$( { tr ' ' '\n' <<<"$(tmux show -gqv @agents-hosts)"; cut -d "$sep" -f1 <<<"$remote" | sort; } | awk 'NF && !seen[$0]++')
  while read -r n; do
    if [[ -z $n ]]; then
      continue
    fi

    add_row ""
    open=" $(awk -F "$sep" -v h="$n" '$1 == h { printf "%s ", $6 }' <<<"$all_remote")"
    if grep -q "^$n$sep" <<<"$remote"; then
      machine_row "$n" "host:$n" 1
      while IFS=$sep read -r host win id m sess rs; do
        space_row "$m" "$sess" "pane:$id@$host"
      done < <(awk -F "$sep" -v h="$n" '$1 == h' <<<"$remote")
    else
      machine_row "$n" "host:$n" 0
    fi
    detached_rows "$n" "$open"
    new_row "$n"
  done <<<"$hosts"

  # A service polled over ssh, such as hermes, has no pane, so its row opens a window on its host
  read -r -a services <<<"$(tmux show -gqv @agents-services)"
  for s in ${services[@]+"${services[@]}"}; do
    p=$(printf '%s_%s' "${s%%:*}" "${s#*:}" | tr -c 'A-Za-z0-9_' '_')
    IFS=$sep read -r state since detail <<<"$(state_read "svc_$p")"
    if [[ -n $state ]]; then
      detail=$(plain "$detail")
      agents+="$state$sep$since$sep${s%%:*}$sep${s#*:}${detail:+ · $detail}${sep}host:${s%%:*}"$'\n'
    fi
  done

  add_row ""
  add_row " ${c_head}Agents${c_fg}"
  for s in blocked working asking waiting idle; do
    n=$(printf '%s' "$agents" | grep -c "^$s$sep")
    if (( n == 0 )); then
      continue
    fi

    add_row ""
    add_row " ${c_meta}$(tr '[:lower:]' '[:upper:]' <<<"${s:0:1}")${s:1}  $n${c_fg}"
    while IFS=$sep read -r state since name title id subs; do
      t=pane:$id
      if [[ $id == host:* ]]; then
        t=$id
      fi
      agent_row "$state" "$since" "$name" "$title" "$t" "$subs"
    done < <(printf '%s' "$agents" | grep "^$s$sep" | sort -t "$sep" -k2,2n)
  done
}

draw() {
  local i height line b frame
  height=$(tmux display -p -t "$TMUX_PANE" '#{pane_height}')
  top=0
  if (( sel >= height )); then
    top=$(( sel - height + 1 ))
  fi

  frame=$'\e[?2026h\e[H'
  for (( i = top; i < ${#rows[@]} && i < top + height; i++ )); do
    b=$'\e[49m'
    if (( i == sel )); then
      b=$c_sel
    fi

    line=${rows[i]//$bg/$b}
    frame+="$b$line"$'\e[K\e[0m'
    if (( i < top + height - 1 )); then
      frame+=$'\n'
    fi
  done
  frame+=$'\e[J\e[?2026l'

  # Most scans change nothing, and rewriting the same frame is what makes the pane flicker
  if [[ $frame != "$last_frame" ]]; then
    printf '%s' "$frame"
    last_frame=$frame
  fi
}

# Moves the selection to the next row with a target, in the given direction
step() {
  local i=$(( sel + $1 ))
  while (( i >= 0 && i < ${#targets[@]} )); do
    if [[ -n ${targets[i]} ]]; then
      sel=$i
      return
    fi
    i=$(( i + $1 ))
  done
}

# Opens a window in the session you are in, attached to a tmux session on the host, a new one unless named
new_space() {
  local connect
  connect="$(cd "$(dirname "$0")" && pwd)/connect"
  tmux new-window -t "$(tmux display -p -c "$1" '#{session_name}'):" "$connect" "$2" ${3:+"$3"}
}

# x on a detached row ends that tmux session on its server, after a confirm. Closing a window never does,
# since the session outliving its window is what keeps an agent running
end_session() {
  local target=${targets[sel]:-} host name
  if [[ $target != attach:* ]]; then
    return
  fi

  host=${target#attach:}
  name=${host#*:}
  host=${host%%:*}
  tmux confirm-before -p "end $host session $name? (y/n)" "run-shell -b \"'$(cd "$(dirname "$0")" && pwd)/agents' end-session '$host' '$name'\""
}

activate() {
  local target=${targets[sel]:-} new=${1:-} kind name host= client
  kind=${target%%:*}
  name=${target#*:}
  if [[ $kind == pane && $name == *@* ]]; then
    host=${name#*@}
    name=${name%%@*}
  fi

  # A click focuses the sidebar, give focus back so it shows where you are again
  tmux last-pane -t "$TMUX_PANE" 2>/dev/null
  # With several terminals attached, switch the one looking at this sidebar, the most recently used
  client=$(tmux list-clients -t "$(tmux display -p -t "$TMUX_PANE" '#{session_id}')" -F '#{client_activity} #{client_name}' | sort -rn | head -1 | cut -d' ' -f2)
  case $kind:$new in
    (session:) tmux switch-client -c "$client" -t "=$name" ;;
    (window:) tmux switch-client -c "$client" -t "$name" \; select-window -t "$name" ;;
    (pane:) tmux switch-client -c "$client" -t "$name" \; select-window -t "$name" \; select-pane -t "$name" ;;
    (host:*) new_space "$client" "$name" ;;
    (attach:*) new_space "$client" "${name%%:*}" "${name#*:}" ;;
    (session:1) tmux new-window -t "=$name:" ;;
    (pane:1)
      if [[ -n $host ]]; then
        new_space "$client" "$host"
      fi
      ;;
  esac
}

# While the sidebar is not focused, highlight where you are: the remote space of the focused pane, or its session
follow() {
  local focused win sess active i
  IFS=' ' read -r focused win sess <<<"$(tmux display -p -t "$TMUX_PANE" '#{pane_active} #{window_id} #{session_name}')"
  if [[ $focused == 1 ]]; then
    return
  fi

  active=$(tmux display -p -t "$win" '#{pane_id}')
  for i in "${!targets[@]}"; do
    if [[ ${targets[i]} == "pane:$active@"* || ${targets[i]} == "pane:$active" ]]; then
      sel=$i
      return
    fi
  done

  for i in "${!targets[@]}"; do
    if [[ ${targets[i]} == "session:$sess" ]]; then
      sel=$i
      return
    fi
  done
}

sidebar() {
  local key rest i c b x y tty_saved want
  export LC_ALL=${LC_ALL:-en_US.UTF-8}
  tmux set -p -t "$TMUX_PANE" @agent_sidebar 1
  # The alternate screen lets tmux pass the wheel through instead of entering copy mode
  printf '\e]2;agents\e\\\e[?1049h\e[?25l\e[?1000h\e[?1006h'
  # Mouse reports arriving between reads would be echoed onto the screen
  tty_saved=$(stty -g)
  stty -echo
  trap 'stty "$tty_saved"; printf "\e[?1006l\e[?1000l\e[?25h\e[?1049l\e[0m"' EXIT
  sel=-1
  top=0
  last_frame=
  while true; do
    # A sidebar in a window nobody is looking at does nothing but check again, each costs about 1.5% cpu awake
    if [[ $(tmux display -p -t "$TMUX_PANE" '#{&&:#{window_active},#{session_attached}}') != 1 ]]; then
      last_frame=
      IFS= read -rsn1 -t 2 key || true
      continue
    fi

    # tmux shares space out again when a window's layout changes, so the sidebar sets its own width back
    want=$(option @agents-sidebar-width 32)
    if [[ $want =~ ^[0-9]+$ && $(tmux display -p -t "$TMUX_PANE" '#{pane_width}') != "$want" ]]; then
      tmux resize-pane -t "$TMUX_PANE" -x "$want" 2>/dev/null
    fi

    build
    if (( sel < 0 || sel >= ${#targets[@]} )) || [[ -z ${targets[sel]:-} ]]; then
      i=$sel
      sel=-1
      step 1
      if (( sel < 0 )); then
        sel=$i
      fi
    fi

    follow
    draw
    key=
    # A timeout returns 1 in bash 3.2 and above 128 in bash 4, a real Enter returns 0 with an empty key
    if ! IFS= read -rsn1 -t 2 key; then
      continue
    fi

    if [[ $key == $'\e' ]]; then
      read -rsn2 -t 1 rest
      key+=$rest
    fi

    # An SGR mouse report reads ESC [ < button ; column ; row, then M on press or m on release
    if [[ $key == $'\e[<' ]]; then
      rest=
      while IFS= read -rsn1 -t 1 c; do
        rest+=$c
        if [[ $c == [Mm] ]]; then
          break
        fi
      done

      IFS=';' read -r b x y <<<"${rest%[Mm]}"
      case $b:${rest: -1} in
        (0:M)
          i=$(( top + y - 1 ))
          if [[ -n ${targets[i]:-} ]]; then
            sel=$i
            activate
          fi
          ;;
        (64:M) step -1 ;;
        (65:M) step 1 ;;
      esac
      continue
    fi

    case $key in
      (j | $'\e[B') step 1 ;;
      (k | $'\e[A') step -1 ;;
      ('') activate ;;
      (n) activate 1 ;;
      (x) end_session ;;
      ($'\e' | $'\t') tmux last-pane ;;
      (q) exit 0 ;;
    esac
  done
}

# prefix+a, closes the sidebar of a window or opens one docked left
toggle() {
  local win=$1 id
  id=$(tmux list-panes -t "$win" -F "#{pane_id} #{@agent_sidebar}" | awk '$2 == 1 { print $1; exit }')
  if [[ -n $id ]]; then
    tmux kill-pane -t "$id"
  else
    tmux split-window -d -t "$win" -hbf -l "$(option @agents-sidebar-width 32)" "exec $0 sidebar"
  fi
}

case ${1:-} in
  sidebar) sidebar ;;
  toggle) toggle "${2:-}" ;;
  build)
    # Prints the rows without drawing, for tests
    export LC_ALL=${LC_ALL:-en_US.UTF-8}
    build
    for i in "${!rows[@]}"; do
      printf '%s|%s\n' "${targets[i]}" "${rows[i]}"
    done
    ;;
  *) echo "usage: sidebar sidebar|toggle <window>|build" >&2; exit 2 ;;
esac
