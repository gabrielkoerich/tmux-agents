#!/usr/bin/env bash
# Tracks coding agents in tmux panes from OSC 7501 or their screens, so agents behind ssh need no install
set -uo pipefail

PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
ssh_config=${TMUX_AGENTS_SSH_CONFIG:-$HOME/.ssh/config}
agent_cmds='^(claude|codex|opencode)$'
source "$(dirname "$0")/lib.sh"
blocked_re='Do you want to|Would you like to run|Allow command\?|Permission required|Allow once|❯ 1\. Yes'
working_re='… \([0-9]+[hms]|esc to interrupt|esc interrupt'

# Reads a screen on stdin, prints blocked or working, or nothing when no agent is busy
classify() {
  local raw screen
  raw=$(cat)
  screen=$(grep -v '^[[:space:]]*$' <<<"$raw" | tail -n 15)
  if [[ $screen =~ $blocked_re ]]; then
    echo blocked
  elif [[ $screen =~ $working_re ]]; then
    echo working
  elif asks "$raw"; then
    echo asking
  fi
}

# True when a finished turn ends on a question: the paragraph above the last turn marker, like
# "✻ Cooked for 1m 37s", has a ? that ends a sentence. The marker skips the task list and input box below it
asks() {
  awk '
    { line[NR] = $0 }
    END {
      for (i = NR; i > 0; i--) {
        if (line[i] ~ /^[^ ].* for [0-9]+[hms]/) {
          break
        }
      }
      if (i == 0) {
        exit 1
      }
      for (i--; i > 0 && line[i] ~ /^[[:space:]]*$/; i--) {
      }
      text = ""
      for (; i > 0 && line[i] !~ /^[[:space:]]*$/; i--) {
        text = line[i] " " text
      }
      exit !(text ~ /\?([[:space:]]|$)/)
    }' <<<"$1"
}

# Prints every Host alias in an ssh config, following Include and skipping patterns
ssh_hosts() {
  local file=$1 kw rest words w f
  if [[ ! -r $file ]]; then
    return 0
  fi

  while read -r kw rest; do
    read -r -a words <<<"$rest"
    case $kw in
      [Hh][Oo][Ss][Tt])
        for w in ${words[@]+"${words[@]}"}; do
          if [[ $w != *[*?!]* ]]; then
            echo "$w"
          fi
        done
        ;;
      [Ii][Nn][Cc][Ll][Uu][Dd][Ee])
        for w in ${words[@]+"${words[@]}"}; do
          w=${w/#\~/$HOME}
          if [[ $w != /* ]]; then
            w=$HOME/.ssh/$w
          fi

          for f in $w; do
            ssh_hosts "$f"
          done
        done
        ;;
    esac
  done <"$file"
}

# Folds the OSC 7501 states of a pane into ours, the most urgent one wins
program_status() {
  case " $1 " in
    *" blocked "* | *" error "*) echo blocked ;;
    *" working "*) echo working ;;
    *) echo idle ;;
  esac
}

# The title of a notification: the agent or the server it runs on, and its project folder, like "claude · homelab".
# Over ssh the folder is the one the server's title shows, the local one is just where ssh started
who_where() {
  local cmd=$1 host=$2 path=$3 title who folder=''
  title=$(plain "$4")
  who=${host:-$cmd}
  if [[ -n $host ]]; then
    if [[ $title =~ :[[:space:]]*(~|~?/[A-Za-z0-9._/~-]*)$ ]]; then
      folder=${BASH_REMATCH[1]##*/}
    fi
  else
    folder=${path##*/}
  fi
  printf '%s%s' "$who" "${folder:+ · $folder}"
}

# An agent's task, from a title with its state glyph, like "✳ Fix login", and nothing for any other title
task_of() {
  if agent_title "$(plain "$1")"; then
    clean_title "$1"
  fi
}

osascript_notify() {
  osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv) subtitle (item 3 of argv) sound name "Glass"' \
    -e 'end run' "$1" "$2" "${3:-}" >/dev/null 2>&1
}

# Clicking a terminal-notifier notification jumps the most recent terminal to the pane, osascript can only show it
# notify <title> <message> [pane] [subtitle]: a click jumps to the pane when there is one
notify() {
  local tmux_bin jump sub=${4:-}
  if [[ $(option @agents-notify on) != on ]]; then
    return
  fi

  # terminal-notifier needs its own permission, so a refusal falls back to a plain notification
  if command -v terminal-notifier >/dev/null; then
    tmux_bin=$(command -v tmux)
    jump="c=\$($tmux_bin list-clients -F '#{client_activity} #{client_name}' | sort -rn | head -1 | cut -d' ' -f2); $tmux_bin switch-client -c \"\$c\" -t '$3' \\; select-window -t '$3' \\; select-pane -t '$3'"
    # A service has no pane to jump to, so its notification only brings the terminal forward
    local click=(-activate "$(option @agents-notify-app com.mitchellh.ghostty)")
    if [[ -n ${3:-} ]]; then
      click+=(-execute "$jump")
    fi

    {
      terminal-notifier -title "$1" -subtitle "$sub" -message "$2" -sound Glass -group "tmux-agents-${3:-$1}" "${click[@]}" >/dev/null 2>&1 ||
        osascript_notify "$1" "$2" "$sub"
    } &
  elif command -v osascript >/dev/null; then
    osascript_notify "$1" "$2" "$sub" &
  elif command -v notify-send >/dev/null; then
    notify-send "$1" "${sub:+$sub
}$2" &
  fi
}

scan() {
  local panes id win cmd prev cur visible place pss pid host rsess remote since path found title state alert headless idle_after now ps_out=
  panes=$(tmux list-panes -a -F "#{pane_id}$sep#{window_id}$sep#{pane_current_command}$sep#{@agent_state}$sep#{@agent_alert}$sep#{&&:#{window_active},#{session_attached}}$sep#{session_name}:#{window_index}$sep#{pane_program_status_states}$sep#{pane_pid}$sep#{@ssh_host}$sep#{@remote_session}$sep#{@agent_since}$sep#{pane_current_path}$sep#{pane_title}") || exit 0
  if grep -Eq "$sep(ssh|mosh-client)$sep" <<<"$panes"; then
    ps_out=$(ps -A -o pid=,ppid=,args=)
  fi

  headless=$(option @agents-headless-sessions '')
  idle_after=$(option @agents-idle-after 600)
  now=$(date +%s)
  while IFS=$sep read -r id win cmd prev cur visible place pss pid host rsess since path title; do
    # A pane connect opened runs ssh under a bash loop, so tmux reports bash, and connect sets the host itself
    remote=
    if [[ $cmd =~ $ssh_cmds || -n $rsess ]]; then
      remote=1
    fi

    # tmux only sees the local ssh process, so keep its host for window names and the sidebar
    if [[ $cmd =~ $ssh_cmds ]] || [[ -n $rsess && -z $host ]]; then
      if [[ -z $ps_out ]]; then
        ps_out=$(ps -A -o pid=,ppid=,args=)
      fi
      found=$(ssh_host_of "$pid" "$ps_out")
      if [[ -n $found && $found != "$host" ]]; then
        tmux set -p -t "$id" @ssh_host "$found" \; set -p -t "$id" @ssh_user "$(ssh_user_of "$found")"
      fi
    elif [[ -n $host && -z $rsess ]]; then
      tmux set -pu -t "$id" @ssh_host
    fi

    state=
    # A headless agent such as claude -p draws no screen, so its session existing is all there is to read
    if [[ -n $headless ]] && headless_session "${place%:*}" "$headless"; then
      state=working
    # OSC 7501 states need a tmux that keeps them, stock tmux leaves the field empty and the screen decides
    elif [[ -n $pss && ( $cmd =~ $agent_cmds || -n $remote ) ]]; then
      state=$(program_status "$pss")
    elif [[ $cmd =~ $agent_cmds || -n $remote ]] || agent_title "$title"; then
      state=$(tmux capture-pane -p -t "$id" | classify)
      # The title keeps its glyph after Claude exits, so only trust it behind ssh where the command hides the agent
      if [[ -z $state ]] && { [[ $cmd =~ $agent_cmds ]] || { [[ -n $remote ]] && { agent_title "$title" || [[ -n $prev ]]; }; }; }; then
        state=idle
      fi
    fi

    # A finished turn is your move, so it waits until it sits untouched for @agents-idle-after seconds
    if [[ $state == idle ]] && { [[ $prev == working ]] || [[ $prev == waiting && $(( now - ${since:-$now} )) -lt $idle_after ]]; }; then
      state=waiting
    fi

    # Agents that predate the timestamp, or a restarted watcher, still get an age
    if [[ -n $state && $state == "$prev" && -z $since ]]; then
      tmux set -p -t "$id" @agent_since "$(date +%s)"
    fi

    if [[ $state != "$prev" ]]; then
      if [[ -n $state ]]; then
        tmux set -p -t "$id" @agent_state "$state" \; set -p -t "$id" @agent_since "$(date +%s)"
      else
        tmux set -pu -t "$id" @agent_state
      fi

      alert=
      if [[ $state == blocked ]]; then
        alert=blocked
      elif [[ $state == asking ]]; then
        alert=asking
      elif [[ $state == waiting && $prev == working ]]; then
        alert=done
      fi

      if [[ -n $alert && $visible != 1 ]]; then
        tmux set -w -t "$win" @agent_alert "$alert"
        notify "$(who_where "$cmd" "$host" "$path" "$title")" "$(case $alert in (blocked) echo 'needs you' ;; (asking) echo 'asks you' ;; (*) echo 'finished' ;; esac) · $place" "$id" "$(task_of "$title")"
      elif [[ $state == working && -n $cur ]]; then
        tmux set -wu -t "$win" @agent_alert
      fi
    fi

    if [[ $visible == 1 && -n $cur ]]; then
      tmux set -wu -t "$win" @agent_alert 2>/dev/null
    fi
  done <<<"$panes"
}

# Reads a hermes gateway's state file and prints the state and a detail, on two lines. The file comes
# from the server, so jq takes only four fields from it and plain keeps only their text
hermes_state() {
  local raw gateway active work attention
  if ! raw=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$1" 'cat ~/.hermes/gateway_state.json' 2>/dev/null); then
    printf 'idle\nunreachable\n'
    return
  fi

  {
    IFS= read -r gateway
    IFS= read -r active
    IFS= read -r work
    IFS= read -r attention
  } < <(jq -r '(.gateway_state // "" | tostring), (.active_agents // 0 | tostring), (.active_work // "" | tostring),
      ([(.platforms // {}) | to_entries[] | select(.value.needs_attention == true) | .key] | join(","))' <<<"$raw" 2>/dev/null)
  gateway=$(plain "${gateway:-}")
  active=$(plain "${active:-0}")
  work=$(plain "${work:-}")
  attention=$(plain "${attention:-}")

  if [[ $gateway != running ]]; then
    printf 'blocked\ngateway %s\n' "${gateway:-unknown}"
  elif [[ -n $attention ]]; then
    printf 'blocked\n%s needs attention\n' "$attention"
  elif [[ $active =~ ^[0-9]+$ ]] && (( active > 0 )); then
    printf 'working\n%s\n' "${work:-$active agents}"
  else
    printf 'idle\n\n'
  fi
}

# Polls every host:service in @agents-services and keeps each one's state in @agents_svc_<host>_<service>
poll_services() {
  local entry entries host name key state detail prev since now
  read -r -a entries <<<"$(option @agents-services '')"
  # bash 3.2 calls an empty array unbound under set -u, so expand it only when it has items
  for entry in ${entries[@]+"${entries[@]}"}; do
    host=${entry%%:*}
    name=${entry#*:}
    case $name in
      (hermes) { IFS= read -r state; IFS= read -r detail; } < <(hermes_state "$host") ;;
      (*) continue ;;
    esac

    key=$(printf '%s_%s' "$host" "$name" | tr -c 'A-Za-z0-9_' '_')
    IFS=$sep read -r prev since _ <<<"$(tmux show -gqv "@agents_svc_$key")"
    now=$(date +%s)
    if [[ $state != "${prev:-}" ]]; then
      since=$now
      if [[ -n ${prev:-} && $state == blocked ]]; then
        notify "$host · $name" "$detail" ""
      elif [[ ${prev:-} == working && $state == idle && $detail != unreachable ]]; then
        notify "$host · $name" "finished" ""
      fi
    fi
    tmux set -g "@agents_svc_$key" "$state$sep${since:-$now}$sep$detail"
  done
}

# Lists the tmux sessions on every pinned machine in @agents_remote_<host>, a line each: name, clients
# attached, the active pane's folder and title. All of it comes from the server, so it is kept as plain text
poll_sessions() {
  local host hosts key raw line name att path title out stats probe
  probe="$(cd "$(dirname "$0")" && pwd)/host-probe.sh"
  read -r -a hosts <<<"$(option @agents-hosts '')"
  for host in ${hosts[@]+"${hosts[@]}"}; do
    key=$(printf '%s' "$host" | tr -c 'A-Za-z0-9_' '_')
    # One round trip a host: the probe goes on stdin to the server's sh and prints its sessions and its stats
    raw=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" 'sh -s' <"$probe" 2>/dev/null)
    # 255 is ssh failing to reach the host, so keep the sessions known and drop the stats, which would be stale
    if [[ $? -eq 255 ]]; then
      tmux set -gu "@agents_stats_$key"
      continue
    fi

    # The stats come from the server too, so they are stored only when they are three numbers
    stats=$(sed -n '/^--stats--$/{n;p;}' <<<"$raw")
    if [[ $stats =~ ^[0-9]{1,3}\|[0-9]{1,3}\|[0-9]+(\.[0-9]+)?$ ]]; then
      tmux set -g "@agents_stats_$key" "$stats"
    else
      tmux set -gu "@agents_stats_$key"
    fi

    raw=$(sed '/^--stats--$/,$d' <<<"$raw")
    out=''
    while IFS='|' read -r name att path title; do
      name=$(plain "$name" | tr -cd 'A-Za-z0-9_.-')
      if [[ -n $name ]]; then
        out+="$name$sep$(plain "$att")$sep$(plain "$path")$sep$(plain "$title")"$'\n'
      fi
    done <<<"$raw"
    tmux set -g "@agents_remote_$key" "$out"
  done
}

watch() {
  local pid poller='' last=0
  pid=$(tmux show -gqv @agent_watch_pid)
  if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
    exit 0
  fi

  tmux set -g @agent_watch_pid $$
  # tmux reports a run -b job killed by a signal, so stop quietly
  trap 'exit 0' TERM
  while true; do
    scan
    # Services are polled over ssh in the background, so a slow server never holds up the panes
    if (( $(date +%s) - last >= $(option @agents-services-interval 30) )) && ! { [[ -n $poller ]] && kill -0 "$poller" 2>/dev/null; }; then
      { poll_services; poll_sessions; } &
      poller=$!
      last=$(date +%s)
    fi
    sleep "$(option @agents-interval 2)"
  done
}

# Most urgent first: blocked, working, asking, waiting, idle
rank() {
  case $1 in
    (blocked) echo 1 ;;
    (working) echo 2 ;;
    (asking) echo 3 ;;
    (waiting) echo 4 ;;
    (*) echo 5 ;;
  esac
}

# One fuzzy list of agents, sessions, windows and ssh hosts, Enter jumps there
pick() {
  local client=$1 icon out key target kind name connect entries entry state detail
  local dim off=$'\e[0m'
  load_palette
  dim=$c_meta
  out=$(
    {
      tmux list-panes -a -F "#{@agent_state}$sep#{pane_id}$sep#{pane_title}$sep#{session_name}:#{window_index}$sep#{pane_current_command}$sep#{@ssh_host}$sep#{pane_current_path}" |
        while IFS=$sep read -r state id title place cmd shost path; do
          title=$(plain "$title")
          place=$(plain "$place")
          case $state in
            (blocked) icon="${c_blocked}!" ;;
            (asking) icon="${c_asking}?" ;;
            (waiting) icon="${c_on}●" ;;
            (working) icon="${c_working}⠿" ;;
            (idle) icon="${c_idle}○" ;;
            (*) continue ;;
          esac

          if [[ -n $shost ]]; then
            cmd=$shost
            path=ssh
          fi
          printf '%s%s%s%s %sagent%s    %-44s %s%s · %s%s\n' "$(rank "$state")" "$sep" "pane:$id$sep" "$icon" "$dim" "$off" "$cmd › $(clean_title "$title")" "$dim" "${path##*/}" "$place" "$off"
        done | sort -s -t "$sep" -k1,1n | cut -d "$sep" -f2-
      tmux list-sessions -F "#{session_name}$sep#{session_windows}" | while IFS=$sep read -r name count; do
        name=$(plain "$name")
        printf 'session:%s%s  %ssession%s  %s %s%s windows%s\n' "$name" "$sep" "$dim" "$off" "$name" "$dim" "$count" "$off"
      done
      # A window name follows its pane's title, so it is plain text before the picker adds its colours
      tmux list-windows -a -F "#{pane_id}$sep#{session_name}:#{window_index}$sep#{window_name}$sep#{s|$HOME|~|:pane_current_path}" |
        while IFS=$sep read -r id place name path; do
          printf 'pane:%s%s  %swindow%s   %s %s %s%s%s\n' "$id" "$sep" "$dim" "$off" "$(plain "$place")" "$(plain "$name")" "$dim" "$(plain "$path")" "$off"
        done
      read -r -a entries <<<"$(option @agents-services '')"
      for entry in ${entries[@]+"${entries[@]}"}; do
        key=$(printf '%s_%s' "${entry%%:*}" "${entry#*:}" | tr -c 'A-Za-z0-9_' '_')
        IFS=$sep read -r state _ detail <<<"$(tmux show -gqv "@agents_svc_$key")"
        case $state in
          (blocked) icon="${c_blocked}!" ;;
          (working) icon="${c_working}⠿" ;;
          (idle) icon="${c_idle}○" ;;
          (*) continue ;;
        esac
        printf 'ssh:%s%s%s %sservice%s  %-44s %s%s%s\n' "${entry%%:*}" "$sep" "$icon" "$dim" "$off" "${entry%%:*} › ${entry#*:}" "$dim" "$(plain "$detail")" "$off"
      done
      ssh_hosts "$ssh_config" | awk '!seen[$0]++' | while read -r name; do
        printf 'ssh:%s%s  %sserver%s   %s\n' "$name" "$sep" "$dim" "$off" "$name"
      done
    } | fzf --ansi --delimiter "$sep" --with-nth 2 --expect ctrl-s --reverse --no-sort \
      --prompt '  ' --pointer '▌' --info inline-right --no-separator \
      --color "$(option @agents-fzf-colors 'bg:-1,bg+:236,fg:250,fg+:255,hl:173,hl+:173,pointer:173,prompt:173,info:240,header:240,gutter:-1')" \
      --header 'enter go · ctrl-s server in a new session'
  ) || return 0

  key=$(sed -n 1p <<<"$out")
  target=$(sed -n 2p <<<"$out" | cut -d "$sep" -f1)
  kind=${target%%:*}
  name=${target#*:}
  case $kind in
    pane) tmux switch-client -c "$client" -t "$name" \; select-window -t "$name" \; select-pane -t "$name" ;;
    session) tmux switch-client -c "$client" -t "$name" ;;
    ssh)
      connect="$(cd "$(dirname "$0")" && pwd)/connect"
      if [[ $key == ctrl-s ]]; then
        tmux new-session -d -s "$name" "$connect" "$name" \; switch-client -c "$client" -t "$name"
      else
        tmux new-window -t "$(tmux display -p -c "$client" '#{session_name}'):" "$connect" "$name"
      fi
      ;;
  esac
}

case ${1:-} in
  watch) watch ;;
  stop) kill "$(tmux show -gqv @agent_watch_pid)" 2>/dev/null ;;
  pick) pick "${2:-}" ;;
  classify) classify ;;
  hosts) ssh_hosts "$ssh_config" ;;
  poll-sessions) poll_sessions ;;
  hermes-state) hermes_state "${2:?usage: tmux-agents hermes-state <host>}" ;;
  *) echo "usage: tmux-agents watch|stop|pick <client>|classify|hosts|hermes-state <host>" >&2; exit 2 ;;
esac
