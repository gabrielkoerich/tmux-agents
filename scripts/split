#!/usr/bin/env bash
# Splits a pane, and a pane on a server gets its new pane on that server, in the folder it shows
set -u
dir=$(cd "$(dirname "$0")" && pwd)
source "$dir/lib.sh"

flag=-h
if [[ ${1:-} == v ]]; then
  flag=-v
fi

pane=${2:?usage: split h|v <pane>}
if found=$(remote_of "$pane"); then
  IFS=$sep read -r target folder <<<"$found"
  # Separate arguments, so tmux runs connect directly and no shell reads a value
  tmux split-window "$flag" -t "$pane" "$dir/connect" "$target" '' "$folder"
  exit 0
fi

tmux split-window "$flag" -t "$pane" -c "$(tmux display -p -t "$pane" '#{pane_current_path}')"
